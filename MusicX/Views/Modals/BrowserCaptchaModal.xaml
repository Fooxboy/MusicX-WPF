<controls:ModalPage x:Class="MusicX.Views.Modals.BrowserCaptchaModal"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:local="using:MusicX.Views.Modals"
           xmlns:modals="clr-namespace:MusicX.ViewModels.Modals"
           xmlns:controls="clr-namespace:MusicX.Controls"
           xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           mc:Ignorable="d"
           Title="Капча" Height="720" Width="400"
           d:DataContext="{d:DesignInstance modals:BrowserCaptchaModalViewModel}"
           Closed="CaptchaModal_OnClosed"
           Background="Transparent">
    <Grid>
        <wpf:WebView2 x:Name="WebView" 
                      NavigationCompleted="WebView_OnNavigationCompleted"
                      DefaultBackgroundColor="Transparent" 
                      Source="{Binding RedirectUri}"
                      DesignModeForegroundColor="Purple"
                      CoreWebView2InitializationCompleted="WebView_OnCoreWebView2InitializationCompleted"/>
        <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" />
    </Grid>
</controls:ModalPage>
